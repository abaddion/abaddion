# Copy to .env.local (never commit). Vercel → Project → Settings → Deployment Protection
# → Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Vercel → Environment Variables (Production + Preview). Injected at build via scripts/inject-build-meta.mjs.
# Create at https://clarity.microsoft.com/ → Settings → Overview → Project ID.
CLARITY_PROJECT_ID=zcn4aq0rzr

# Interactive Sand (POST /api/sand-chat). Defaults: api/sand-chat.config.json
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_MAX_OUTPUT_TOKENS=
# GEMINI_TEMPERATURE=

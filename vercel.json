{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/content.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/canvas", "destination": "/index.html" },
    { "source": "/canvas/:slug", "destination": "/index.html" },
    { "source": "/code", "destination": "/index.html" },
    { "source": "/code/:slug", "destination": "/index.html" },
    { "source": "/career-pages", "destination": "/index.html" },
    { "source": "/career-pages/:slug", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about/:slug", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/contact/:slug", "destination": "/index.html" }
  ]
}
